{
  "name": "bread-baileys",
  "type": "module",
  "version": "0.0.1",
  "description": "bread-baileys: a custom WebSockets-based TypeScript library for interacting with WhatsApp Web, with interactive messages and AI rich responses",
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "baileys",
    "bread-baileys",
    "bread",
    "automation",
    "bot",
    "websocket",
    "multi-device"
  ],
  "license": "MIT",
  "author": "bread",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "build": "tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "preinstall": "node ./engine-requirements.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrBreadz/bread-baileys.git"
  },
  "homepage": "https://github.com/DrBreadz/bread-baileys#readme"
}
